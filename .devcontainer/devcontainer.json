{
  "name": "Privy coding interview (Java 21 + Maven)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    }
  },
  "postCreateCommand": "mvn -q dependency:go-offline && mvn -q test",
  "forwardPorts": [7070],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "editor.fontSize": 16
      }
    }
  }
}
